# Forma recomendada (URL única). Exemplo:
DATABASE_URL="postgresql://usuario:senha@1.1.0.0:5432/opcoes"

# Nome do banco de dados que você criou no PostgreSQL
POSTGRES_DB=example
# Usuário com permissão para acessar esse banco
POSTGRES_USER=example
# Senha para o usuário do banco
POSTGRES_PASSWORD="example"
# IP do seu servidor de banco de dados
DB_HOST=1.1.0.0
# Porta do seu servidor de banco de dados
DB_PORT=1234

# Schema operacional padrão (modo web ajusta para schema do usuário logado)
# OPCOES_PG_SCHEMA=admin

# Schema da autenticação web (tabela web_users)
# OPCOES_AUTH_SCHEMA=auth

# Chave obrigatoria em producao (use valor unico e forte)
# OPCOES_SECRET_KEY=troque-por-uma-chave-unica-bem-longa

# Em producao, mantenha debug desligado e cookie seguro ligado
# OPCOES_WEB_DEBUG=0
# OPCOES_SESSION_COOKIE_SECURE=1
# OPCOES_SESSION_COOKIE_SAMESITE=Lax

# Legado opcional: arquivo auth.db usado apenas para migração de usuários antigos
# OPCOES_AUTH_LEGACY_DB_PATH=data/auth.db

# Cache da home/ranking por usuário (segundos). 0 desativa.
# Útil para reduzir latência do "/" em ambiente com PostgreSQL remoto.
# OPCOES_RANKING_CACHE_SECONDS=45

# Edge API publica na VPS -> gateway privado MT5 no Windows
# Exemplo com Tailscale:
# MT5_GATEWAY_BASE_URL=http://100.64.0.10:8000
# MT5_GATEWAY_KEY_ID=edge-1
# MT5_GATEWAY_SHARED_SECRET=troque-por-um-segredo-forte
# MT5_GATEWAY_TIMEOUT_SECONDS=10
#
# Tokens publicos da edge API. Formato: nome=token,nome2=token2
# OPCOES_EDGE_API_TOKENS=excel=troque-este-token,app=troque-outro-token
#
# Se nao definir, usa OPCOES_SECRET_KEY para assinar tickets do WebSocket.
# OPCOES_EDGE_WS_TOKEN_SECRET=troque-por-um-segredo-forte
# OPCOES_EDGE_WS_TOKEN_TTL_SECONDS=60
# OPCOES_EDGE_WS_POLL_INTERVAL_MS=1000
# OPCOES_EDGE_QUOTE_CACHE_MS=500
# OPCOES_EDGE_HOST=0.0.0.0
# OPCOES_EDGE_PORT=8001
