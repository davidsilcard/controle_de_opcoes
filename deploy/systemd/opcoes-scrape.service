[Unit]
Description=Atualiza snapshots e filtros da aplicação Opções
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=david
Group=docker
WorkingDirectory=/home/david/apps/controle_de_opcoes
ExecStart=/usr/bin/flock -n /tmp/opcoes-scrape.lock /bin/bash /home/david/apps/controle_de_opcoes/deploy/scripts/run_scrape_cycle.sh
Nice=10

[Install]
WantedBy=multi-user.target
